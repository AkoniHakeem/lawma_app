                            >Add New Property Type</q-tooltip
                          >
                        </q-btn>
                        <q-btn
                          icon="refresh"
                          color="secondary"
                          rounded
                          @click="refreshPropertyTypes"
                          class="action-btn"
                          :loading="propertyTypesLoading"
                        >
                          <q-tooltip class="bg-secondary"
                            >Refresh Property Types</q-tooltip
                          >
                        </q-btn>
                      </div>
                    </div>
                  </div>
                </q-card-section>
              </q-card>

              <!-- Property Type Form -->
              <q-card class="enhanced-card q-mt-md" flat>
