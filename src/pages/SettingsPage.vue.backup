              size="lg"
              icon="settings"
              @click="refreshAllData"
              class="action-btn-enhanced"
              :loading="refreshLoading"
            >
              Refresh Settings
              <q-tooltip class="bg-primary"
                >Refresh All Settings Data</q-tooltip
              >
            </q-btn>
          </div>
        </div>
      </div>

      <!-- Enhanced Navigation Tabs -->
      <div class="navigation-section">
