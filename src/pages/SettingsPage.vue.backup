<script setup lang="ts">
import {
  computed,
  inject,
  onBeforeUnmount,
  onMounted,
  reactive,
  ref,
  watch,
} from 'vue';
import { PropertySubscriptionHandler } from 'src/lib/eventHandlers/PropertySubscription.handler';
import { PropertyTypeModel } from 'src/models/PropertyType.model';
import { asyncComputed } from '@vueuse/core';
import { QForm, EventBus, useQuasar, QTableColumn } from 'quasar';
import { EventNamesEnum } from 'src/lib/enums/events.enum';
import { isModelValid, clearUIEffects } from 'src/lib/utils';
import { useNotify } from 'src/composables/useNotify';

enum NamedTabsEnum {
  PROPERTY_TYPES = 'Property Types',
  SYSTEM_CONFIG = 'System Config',
  USER_MANAGEMENT = 'User Management',
  DATA_BACKUP = 'Data Backup',
}

// Enhanced column definitions for property types table
const propertyTypeColumns: QTableColumn[] = [
  {
    field: 'name',
    label: 'Property Type Name',
    name: 'name',
    align: 'left',
    sortable: true,
  },
  {
    field: 'unitPrice',
    label: 'Unit Price',
    name: 'unitPrice',
    align: 'right',
    sortable: true,
  },
  {
    field: 'actions',
    label: 'Actions',
    name: 'actions',
    align: 'center',
    sortable: false,
  },
];

// Constants
const eventBus = inject('eventBus') as EventBus;
const $q = useQuasar();

// Variables
let timer: NodeJS.Timeout;

// Reactive refs
const currentTab = ref<NamedTabsEnum>(NamedTabsEnum.PROPERTY_TYPES);
const propertyTypes = ref<PropertyTypeModel[]>([]);
const propertyTypeForm = ref<QForm>();
const propertyTypeId = ref();
const propertyTypesLoading = ref(false);
const propertyTypeSubmitting = ref(false);
const propertyTypeDeleting = ref(false);
const refreshLoading = ref(false);
const configSaving = ref(false);

// Models
const propertyTypeModel = reactive(new PropertyTypeModel());

// System configuration model
const systemConfig = reactive({
  // General Settings
  maintenanceMode: false,
  autoBackup: true,
  emailNotifications: true,
  appName: 'LAWMA Waste Management System',

  // Security Settings
  twoFactorAuth: false,
  auditLogging: true,
  sessionTimeout: 30,
  maxLoginAttempts: 5,

  // Payment Settings
  defaultCurrency: 'NGN',
  lateFeePercentage: 5,
  gracePeriodDays: 7,
  autoGenerateInvoices: true,
  invoicePrefix: 'INV-',
  invoiceTemplate: 'default',
});

// User management data
const userStats = reactive({
  totalUsers: 45,
  activeUsers: 38,
  adminUsers: 5,
  standardUsers: 33,
  inactiveUsers: 7,
  pendingUsers: 2,
});

const userRoles = ref([
  {
    id: 1,
    name: 'Super Admin',
    icon: 'admin_panel_settings',
    permissions: ['all_permissions'],
    description: 'Full system access',
  },
  {
    id: 2,
    name: 'Admin',
    icon: 'verified_user',
    permissions: ['user_management', 'billing', 'reports'],
    description: 'Administrative access',
  },
  {
    id: 3,
    name: 'Billing Officer',
    icon: 'receipt',
    permissions: ['billing', 'payments', 'reports'],
    description: 'Billing and payment management',
  },
  {
    id: 4,
    name: 'Field Officer',
    icon: 'location_on',
    permissions: ['property_management', 'collection'],
    description: 'Field operations',
  },
]);

const userRoleColumns: QTableColumn[] = [
  {
    field: 'name',
    label: 'Role Name',
    name: 'name',
    align: 'left',
    sortable: true,
  },
  {
    field: 'permissions',
    label: 'Permissions',
    name: 'permissions',
    align: 'left',
    sortable: false,
  },
  {
    field: 'description',
    label: 'Description',
    name: 'description',
    align: 'left',
    sortable: false,
  },
  {
    field: 'actions',
    label: 'Actions',
    name: 'actions',
    align: 'center',
    sortable: false,
  },
];

const recentActivity = ref([
  {
    id: 1,
    text: 'John Doe logged in',
    timestamp: new Date().toISOString(),
    icon: 'login',
    color: 'green',
  },
  {
    id: 2,
    text: 'Payment processed for Property #12345',
    timestamp: new Date(Date.now() - 300000).toISOString(),
    icon: 'payment',
    color: 'blue',
  },
  {
    id: 3,
    text: 'New user registration pending approval',
    timestamp: new Date(Date.now() - 600000).toISOString(),
    icon: 'person_add',
    color: 'orange',
  },
]);

// Backup management data
const backupStatus = reactive({
  isHealthy: true,
  lastBackup: '2 hours ago',
  totalSize: '2.5 GB',
  backupCount: 15,
});

const backupHistory = ref([
  {
    id: 1,
    name: 'Daily Backup - 2025-01-18',
    date: '2025-01-18 02:00:00',
    status: 'Success',
    size: '1.2 GB',
    type: 'Automatic',
  },
  {
    id: 2,
    name: 'Manual Backup - 2025-01-17',
    date: '2025-01-17 14:30:00',
    status: 'Success',
    size: '1.1 GB',
    type: 'Manual',
  },
  {
    id: 3,
    name: 'Daily Backup - 2025-01-17',
    date: '2025-01-17 02:00:00',
    status: 'Failed',
    size: '0 GB',
    type: 'Automatic',
  },
]);

const backupHistoryColumns: QTableColumn[] = [
  {
    field: 'name',
    label: 'Backup Name',
    name: 'name',
    align: 'left',
    sortable: true,
  },
  {
    field: 'date',
    label: 'Date Created',
    name: 'date',
    align: 'left',
    sortable: true,
    format: (val: string) => formatDate(val),
  },
  {
    field: 'status',
    label: 'Status',
    name: 'status',
    align: 'center',
    sortable: true,
  },
  {
    field: 'size',
    label: 'Size',
    name: 'size',
    align: 'right',
    sortable: true,
  },
  {
    field: 'actions',
    label: 'Actions',
    name: 'actions',
    align: 'center',
    sortable: false,
  },
];

const backupSettings = reactive({
  autoBackup: true,
  frequency: 'daily',
  retentionDays: 30,
  storageLocation: 'local',
  compression: true,
  encryption: false,
});

// Loading states
const rolesLoading = ref(false);
const activityLoading = ref(false);
const backupInProgress = ref(false);
const backupHistoryLoading = ref(false);
const backupSettingsSaving = ref(false);

// Dialog states
const showAddUserDialog = ref(false);
const showBulkImportDialog = ref(false);
const showAddRoleDialog = ref(false);
const showScheduleDialog = ref(false);
const showRestoreDialog = ref(false);

// Options
const invoiceTemplateOptions = [
  { label: 'Default Template', value: 'default' },
  { label: 'Professional Template', value: 'professional' },
  { label: 'Minimal Template', value: 'minimal' },
];

const backupFrequencyOptions = [
  { label: 'Daily', value: 'daily' },
  { label: 'Weekly', value: 'weekly' },
  { label: 'Monthly', value: 'monthly' },
];

const storageLocationOptions = [
  { label: 'Local Storage', value: 'local' },
  { label: 'Cloud Storage', value: 'cloud' },
  { label: 'Network Storage', value: 'network' },
];

// Computed properties
const propertyTypesOptions = computed(() => {
  return propertyTypes.value.map((propertytype) => {
    return {
      label: `${propertytype.name} - ₦${formatCurrency(
        propertytype.unitPrice
      )}`,
      value: propertytype.id,
    };
  });
});

asyncComputed(async () => {
  await propertyTypeModel.validate();
});

// Event handlers
PropertySubscriptionHandler.handlePostPropertyType(eventBus, {
  onSuccess: onPropertyTypeSuccess,
  onError: onPropertyTypeError,
});

// Enhanced helper methods
function formatCurrency(amount: number | string): string {
  if (amount === null || amount === undefined || amount === '') return '0.00';

  const numAmount = typeof amount === 'string' ? parseFloat(amount) : amount;
  if (isNaN(numAmount)) return '0.00';

  return numAmount.toLocaleString('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function clearPropertyTypeForm() {
  propertyTypeModel.clearValues();
  propertyTypeId.value = null;
}

function editPropertyType(propertyType: PropertyTypeModel) {
  propertyTypeId.value = propertyType.id;
  propertyTypeModel.id = propertyType.id;
  propertyTypeModel.name = propertyType.name;
  propertyTypeModel.unitPrice = propertyType.unitPrice;
}

function confirmDeletePropertyType(propertyType: PropertyTypeModel) {
  $q.dialog({
    title: 'Confirm Delete',
    message: `Are you sure you want to delete "${propertyType.name}"?`,
    cancel: true,
    persistent: true,
    color: 'negative',
  }).onOk(() => {
    deletePropertyTypeById(propertyType.id);
  });
}

async function deletePropertyTypeById(id: string) {
  propertyTypeDeleting.value = true;

  try {
    // TODO: Implement actual delete API call
    // await PropertySubscriptionHandler.deletePropertyType(id);

    // For now, just remove from local array
    propertyTypes.value = propertyTypes.value.filter((pt) => pt.id !== id);

    useNotify({
      type: 'positive',
      message: 'Property type deleted successfully!',
    });

    clearPropertyTypeForm();
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to delete property type. Please try again.',
    });
  } finally {
    propertyTypeDeleting.value = false;
  }
}

async function deletePropertyType() {
  if (propertyTypeModel.id) {
    confirmDeletePropertyType(propertyTypeModel);
  }
}

async function refreshPropertyTypes() {
  propertyTypesLoading.value = true;

  try {
    propertyTypes.value = await PropertySubscriptionHandler.getPropertyTypes();

    useNotify({
      type: 'positive',
      message: 'Property types refreshed successfully!',
    });
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to refresh property types.',
    });
  } finally {
    propertyTypesLoading.value = false;
  }
}

async function refreshAllData() {
  refreshLoading.value = true;

  try {
    await refreshPropertyTypes();

    useNotify({
      type: 'positive',
      message: 'All settings data refreshed successfully!',
    });
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to refresh settings data.',
    });
  } finally {
    refreshLoading.value = false;
  }
}

async function saveSystemConfig() {
  configSaving.value = true;

  try {
    // TODO: Implement actual save API call
    // await SystemConfigHandler.saveConfig(systemConfig);

    useNotify({
      type: 'positive',
      message: 'System configuration saved successfully!',
    });
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to save system configuration.',
    });
  } finally {
    configSaving.value = false;
  }
}

async function resetToDefaults() {
  $q.dialog({
    title: 'Reset to Defaults',
    message: 'Are you sure you want to reset all settings to default values?',
    cancel: true,
    persistent: true,
    color: 'warning',
  }).onOk(() => {
    // Reset to default values
    Object.assign(systemConfig, {
      maintenanceMode: false,
      autoBackup: true,
      emailNotifications: true,
      appName: 'LAWMA Waste Management System',
      twoFactorAuth: false,
      auditLogging: true,
      sessionTimeout: 30,
      maxLoginAttempts: 5,
      defaultCurrency: 'NGN',
      lateFeePercentage: 5,
      gracePeriodDays: 7,
      autoGenerateInvoices: true,
      invoicePrefix: 'INV-',
      invoiceTemplate: 'default',
    });

    useNotify({
      type: 'positive',
      message: 'Settings reset to default values!',
    });
  });
}

async function exportConfig() {
  try {
    const config = JSON.stringify(systemConfig, null, 2);
    const blob = new Blob([config], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `lawma-config-${new Date().toISOString().split('T')[0]}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    useNotify({
      type: 'positive',
      message: 'Configuration exported successfully!',
    });
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to export configuration.',
    });
  }
}

// User Management Functions
function editRole(role: any) {
  // TODO: Implement role editing
  useNotify({
    type: 'info',
    message: `Edit role: ${role.name}`,
  });
}

function deleteRole(role: any) {
  $q.dialog({
    title: 'Delete Role',
    message: `Are you sure you want to delete the role "${role.name}"?`,
    cancel: true,
    persistent: true,
    color: 'negative',
  }).onOk(() => {
    // TODO: Implement role deletion
    useNotify({
      type: 'positive',
      message: 'Role deleted successfully!',
    });
  });
}

function refreshUserActivity() {
  activityLoading.value = true;

  setTimeout(() => {
    // TODO: Implement actual API call
    activityLoading.value = false;
    useNotify({
      type: 'positive',
      message: 'User activity refreshed!',
    });
  }, 1000);
}

// Backup Management Functions
async function createBackup() {
  backupInProgress.value = true;

  try {
    // TODO: Implement actual backup creation
    await new Promise((resolve) => setTimeout(resolve, 3000)); // Simulate backup process

    const newBackup = {
      id: Date.now(),
      name: `Manual Backup - ${new Date().toLocaleDateString()}`,
      date: new Date().toISOString(),
      status: 'Success',
      size: '1.3 GB',
      type: 'Manual',
    };

    backupHistory.value.unshift(newBackup);
    backupStatus.lastBackup = 'Just now';
    backupStatus.backupCount++;

    useNotify({
      type: 'positive',
      message: 'Backup created successfully!',
    });
  } catch (error) {
    useNotify({
      type: 'negative',
      message: 'Failed to create backup.',
    });
  } finally {
    backupInProgress.value = false;
  }
}

function refreshBackupHistory() {
  backupHistoryLoading.value = true;

  setTimeout(() => {
    // TODO: Implement actual API call
    backupHistoryLoading.value = false;
    useNotify({
      type: 'positive',
      message: 'Backup history refreshed!',
    });
  }, 1000);
}

function downloadBackup(backup: any) {
  useNotify({
    type: 'info',
    message: `Downloading backup: ${backup.name}`,
  });
  // TODO: Implement actual download
}

function restoreFromBackup(backup: any) {
  $q.dialog({
    title: 'Restore from Backup',
    message: `Are you sure you want to restore from "${backup.name}"? This will overwrite current data.`,
    cancel: true,
    persistent: true,
    color: 'warning',
  }).onOk(() => {
    useNotify({
      type: 'positive',
      message: 'Restore initiated. This may take a few minutes.',
    });
    // TODO: Implement actual restore
  });
}

function deleteBackup(backup: any) {
  $q.dialog({
    title: 'Delete Backup',
    message: `Are you sure you want to delete "${backup.name}"? This action cannot be undone.`,
    cancel: true,
    persistent: true,
    color: 'negative',
  }).onOk(() => {
    backupHistory.value = backupHistory.value.filter((b) => b.id !== backup.id);
    backupStatus.backupCount--;

    useNotify({
      type: 'positive',
      message: 'Backup deleted successfully!',
    });
  });
}

function saveBackupSettings() {
  backupSettingsSaving.value = true;

  setTimeout(() => {
    // TODO: Implement actual save
    backupSettingsSaving.value = false;
    useNotify({
      type: 'positive',
      message: 'Backup settings saved successfully!',
    });
  }, 1000);
}

function getStatusColor(status: string) {
  switch (status.toLowerCase()) {
    case 'success':
      return 'green';
    case 'failed':
      return 'red';
    case 'in progress':
      return 'blue';
    default:
      return 'grey';
  }
}

function getStatusIcon(status: string) {
  switch (status.toLowerCase()) {
    case 'success':
      return 'check_circle';
    case 'failed':
      return 'error';
    case 'in progress':
      return 'schedule';
    default:
      return 'help';
  }
}

function formatTime(timestamp: string): string {
  return new Date(timestamp).toLocaleString();
}

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString();
}

// Enhanced form submission
function onSubmit() {
  if (!isModelValid(propertyTypeModel)) {
    propertyTypeForm.value?.validate();
    return;
  }

  propertyTypeSubmitting.value = true;

  eventBus.emit(EventNamesEnum.POST_PROPERTY_TYPE, propertyTypeModel);

  timer = setTimeout(() => {
    propertyTypeSubmitting.value = false;
    useNotify({
      type: 'negative',
      message: 'Request timeout. Please try again.',
    });
  }, 10000);
}

function onPropertyTypeSuccess() {
  propertyTypeSubmitting.value = false;

  // Clear form
  clearPropertyTypeForm();

  // Refresh property types
  refreshPropertyTypes();

  useNotify({
    type: 'positive',
    message: 'Property type saved successfully!',
  });

  clearUIEffects({ loader: $q.loading, timer });
}

function onPropertyTypeError() {
  propertyTypeSubmitting.value = false;

  useNotify({
    type: 'negative',
    message: 'Failed to save property type. Please try again.',
  });

  clearUIEffects({ loader: $q.loading, timer });
}

// Watchers
watch(propertyTypeId, (newValue) => {
  if (newValue) {
    const propertyTypeToEdit = propertyTypes.value.find(
      (eachType) => eachType.id === newValue
    );
    if (propertyTypeToEdit) {
      propertyTypeModel.id = propertyTypeToEdit.id;
      propertyTypeModel.name = propertyTypeToEdit.name;
      propertyTypeModel.unitPrice = propertyTypeToEdit.unitPrice;
    }
  } else {
    propertyTypeModel.id = undefined;
    propertyTypeModel.name = '';
    propertyTypeModel.unitPrice = 0;
  }
});

// Lifecycle hooks
onMounted(async () => {
  await refreshPropertyTypes();
});

// Cleanup
onBeforeUnmount(() => {
  eventBus.off(EventNamesEnum.POST_PROPERTY_TYPE);
  if (timer) {
    clearTimeout(timer);
  }
});
</script>

