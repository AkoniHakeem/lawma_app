        >
          <!-- Property Types Management -->
          <q-tab-panel :name="NamedTabsEnum.PROPERTY_TYPES" class="q-pa-none">
            <div class="tab-content">
              <!-- Property Types Filter Section -->
              <q-card class="enhanced-card" flat>
                <q-card-section class="card-header">
