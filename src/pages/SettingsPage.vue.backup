              align="left"
              narrow-indicator
              class="settings-tabs"
            >
              <q-tab
                :name="NamedTabsEnum.PROPERTY_TYPES"
                icon="home_work"
                :label="NamedTabsEnum.PROPERTY_TYPES"
                class="settings-tab"
              />
