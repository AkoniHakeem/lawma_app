                      color="primary"
                      size="sm"
                      class="q-mr-sm"
                    />
                    <h6 class="text-h6 q-ma-none text-weight-bold">
                      {{ propertyTypeModel.id ? 'Edit' : 'Add New' }} Property
                      Type
                    </h6>
                  </div>
                </q-card-section>

                <q-separator />

                <q-card-section>
                  <q-form ref="propertyTypeForm" @submit.prevent="onSubmit">
