                </q-card-section>

                <q-separator />

                <q-card-section>
                  <div class="row items-center justify-between q-gutter-md">
                    <div class="col-12 col-md-6">
                      <q-select
                        v-model="propertyTypeId"
                        label="Select Property Type to Edit"
                        filled
