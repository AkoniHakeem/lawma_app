                          </h6>
                          <div class="q-mb-md">
                            <q-input
                              v-model="propertyTypeModel.unitPrice"
                              label="Unit Price"
                              filled
                              outlined
                              color="primary"
                              type="number"
                              prefix="₦"
                              :rules="[
                                () =>
                                  $validateField(
                                    propertyTypeModel,
                                    'unitPrice'
                                  ),
                              ]"
                            >
                              <template v-slot:prepend>
                                <q-icon name="payments" />
                              </template>
                            </q-input>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="row justify-center q-mt-lg">
                      <div class="row q-gutter-md">
                        <q-btn
                          :label="
                            propertyTypeModel.id
